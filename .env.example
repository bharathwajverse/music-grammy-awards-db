# ==============================================================================
# GRAMMY Awards Information & Analytics System
# Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR ATLAS PASSWORDS TO VERSION CONTROL
# Copy this file to .env and supply your local or team credentials
# ==============================================================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Target Databases (Five Separate Member Databases)
DB_HISTORY_NAME=grammy_history_db
DB_CATEGORIES_NAME=grammy_categories_db
DB_NOMINATIONS_NAME=grammy_nominations_db
DB_WINNERS_NAME=grammy_winners_db
DB_CREATORS_NAME=grammy_creators_db

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
VERIFICATION_STRICT_MODE=true
