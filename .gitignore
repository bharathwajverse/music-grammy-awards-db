# ==============================================================================
# GRAMMY Awards Information & Analytics System - .gitignore
# Strictly prevents credentials, caches, dependencies, and temporary files
# ==============================================================================

# 1. Environment Variables, Keys, and Secrets (CRITICAL: ZERO SECRETS IN GIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets/

# 2. Python Virtual Environments, Dependencies & Compilations
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 3. Node / JavaScript Dependencies & Logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. Testing, Coverage & Profiling Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# 5. Data & Database Storage Caches (Raw data archives & local DB dumps)
data/raw/*
!data/raw/.gitkeep
data/backups/*
!data/backups/.gitkeep
*.dump
*.tar.gz
*.zip

# 6. IDEs, Editors & Operating System Artifacts
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.Spotlight-V100
.Trashes

# 7. Local Logs and Temporary Files
*.log
scratch/
tmp/
temp/
